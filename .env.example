# Runtime configuration for Classroom Digital Twin.
# Copy this file to .env and change the values below.

# --- PostgreSQL Configuration ---
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASS
POSTGRES_DB=DT-DB

# --- Backend Configuration ---
# If running natively (not Docker), change the host from 'db' to '127.0.0.1'
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
TEST_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}_test

TWIN_TIMEZONE=Africa/Casablanca
TWIN_INGEST_TOKEN=

# Hysteresis
OCCUPIED_CONFIRM_SECONDS=2
EMPTY_CONFIRM_SECONDS=3
